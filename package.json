{
  "name": "dsh-image-gen-mcp",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: image generation through a configurable, provider-agnostic backend. It mounts the bundled stdio MCP server behind an NDJSON bridge, exposing mcp__image_generation__image_generate and mcp__image_generation__image_config_status, and registers the bundled image-generation skill.",
  "type": "module",
  "license": "MIT",
  "author": "bauerelizabeth07139",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauerelizabeth07139/image-gen-mcp.git"
  },
  "homepage": "https://github.com/bauerelizabeth07139/image-gen-mcp#readme",
  "bugs": {
    "url": "https://github.com/bauerelizabeth07139/image-gen-mcp/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bridge.mjs",
    "cordis.patch.yml",
    "locale",
    "assets",
    "skills",
    "scripts",
    "tests",
    "test",
    "README.md",
    "LICENSE",
    ".mcp.json",
    ".codex-plugin"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "icon": "./assets/icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/plugin.test.mjs && node test/bridge.test.mjs && node --import ./test/hooks.mjs test/mount.test.mjs && node --import ./test/hooks.mjs test/skill.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "image-generation",
    "text-to-image",
    "skill"
  ]
}
